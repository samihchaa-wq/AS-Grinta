{
  "name": "as-grinta-lineup-video",
  "private": true,
  "version": "1.0.0",
  "description": "Présentation cinématique des compositions AS Grinta (rendu MP4 avec Remotion).",
  "type": "module",
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "studio": "npm run prepare-assets && remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "render:sample": "npm run prepare-assets && node scripts/render-sample.mjs",
    "render:jobs": "npm run prepare-assets && node scripts/render-jobs.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource/roboto": "5.3.0",
    "@remotion/bundler": "4.0.534",
    "@remotion/layout-utils": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.534",
    "@types/node": "22.18.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "zod": "4.6.7"
  }
}
